rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function meetingMember(meetingId) {
      let meeting = get(/databases/$(database)/documents/meetings/$(meetingId)).data;
      return signedIn()
        && (meeting.hostId == request.auth.uid
          || meeting.participants.hasAny([request.auth.uid]));
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /devices/{deviceId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /meetings/{meetingId} {
      allow get: if signedIn();
      allow list: if signedIn()
        && (resource.data.hostId == request.auth.uid
          || resource.data.participants.hasAny([request.auth.uid]));
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.status in ['scheduled', 'active'];
      allow update: if signedIn() && (
        (
          resource.data.hostId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt', 'durationSeconds'])
          && request.resource.data.status == 'ended'
        )
        || (
          (resource.data.hostId == request.auth.uid
            || resource.data.participants.hasAny([request.auth.uid]))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'status', 'startedAt'])
          && (
            (
              request.resource.data.participants.toSet()
                .difference(resource.data.participants.toSet()).hasOnly([request.auth.uid])
              && request.resource.data.status == 'active'
            )
            || (
              resource.data.participants.toSet()
                .difference(request.resource.data.participants.toSet()).hasOnly([request.auth.uid])
              && request.resource.data.status == resource.data.status
            )
          )
        )
      );
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      match /participants/{participantId} {
        allow read: if meetingMember(meetingId);
        allow create: if meetingMember(meetingId)
          && signedIn()
          && request.auth.uid == participantId
          && request.resource.data.userId == participantId
          && request.resource.data.active == true;
        allow update: if meetingMember(meetingId)
          && signedIn()
          && (
            request.auth.uid == participantId
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isMuted', 'isCameraOff', 'active'])
            || get(/databases/$(database)/documents/meetings/$(meetingId)).data.hostId
              == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isMuted', 'isCameraOff', 'active'])
          );
        allow delete: if meetingMember(meetingId)
          && signedIn()
          && (request.auth.uid == participantId
            || get(/databases/$(database)/documents/meetings/$(meetingId)).data.hostId == request.auth.uid);
      }

      match /messages/{messageId} {
        allow read: if meetingMember(meetingId);
        allow create: if meetingMember(meetingId)
          && signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.meetingId == meetingId
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 2000
          && request.resource.data.timestamp is timestamp
          && get(/databases/$(database)/documents/meetings/$(meetingId)).data.status == 'active';
        allow update, delete: if false;
      }

      match /signaling/{signalId} {
        allow read: if meetingMember(meetingId);
        allow create, update: if meetingMember(meetingId)
          && signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.to != request.auth.uid
          && request.resource.data.type in ['offer', 'answer', 'ice'];
        allow delete: if meetingMember(meetingId)
          && signedIn()
          && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
    }
  }
}
