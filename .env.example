# Supabase Configuration (Get from Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# TURN Server Configuration (Recommended for production WebRTC over cellular and firewalls)
# Comma-separate multiple URLs if needed. Never hardcode private credentials in source code.
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=

# Google OAuth client IDs (Optional)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
